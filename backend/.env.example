# VaaniSeva Round 2 runtime configuration.
# Copy to .env, fill locally, and never commit the resulting .env file.

# AWS is supplied by your local AWS profile or the EC2 instance role.
# Do not place long-lived AWS access keys in this file on EC2.
# The accepted Nova Lite setup is in us-east-1. EC2 may still run in Mumbai.
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0

# Speech providers
SARVAM_API_KEY=
CARTESIA_API_KEY=
CARTESIA_MODEL_ID=sonic-3.5
CARTESIA_VOICE_ID=95d51f79-c397-46f9-b49a-23763d3eaa2d
# Hitesh and Vidya currently route to Sarvam; these remain optional overrides.
CARTESIA_HITESH_VOICE_ID=
CARTESIA_VIDYA_VOICE_ID=

# Telephony. PUBLIC_BASE_URL must be the exact public HTTPS origin with no path.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
PUBLIC_BASE_URL=https://voice.example.org
# Bare hostname used by Caddy for automatic TLS (no scheme or path).
VOICE_DOMAIN=voice.example.org

# Static website origins allowed to request demo callbacks.
WEB_ALLOWED_ORIGINS=https://your-project.vercel.app
CALLBACK_ENABLED=false

# Required for one-way phone hashing in safe caller memory.
# Generate a long random value; never reuse a password or Twilio token.
MEMORY_HASH_SALT=
MEMORY_DB_PATH=/app/data/caller_memory.sqlite3

# Optional live mandi data. When absent/stale, VaaniSeva refuses to quote a price.
DATA_GOV_API_KEY=

# Read-only semantic RAG. Credentials come from the EC2 instance role.
RAG_AWS_REGION=us-east-1
RAG_VECTORS_TABLE=vaaniseva-vectors
RAG_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0

LOG_LEVEL=INFO
